# System Environment Variables Configuration

# API Settings
PROJECT_NAME="AI Content Extraction Service"
API_V1_STR="/v1"
SECRET_KEY="dev_secret_key_change_in_production"
ENVIRONMENT="development"

# Database & Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=content_extraction
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_extraction

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Configurations
LLM_PROVIDER=openai # 'openai' or 'gemini'
LLM_MODEL=gpt-4o   # 'gpt-4o', 'gpt-4.1-mini', 'gemini-2.0-flash', etc.
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Object Storage / File Upload
STORAGE_BACKEND=local # 'local' or 's3'
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET_NAME=wml-content-extraction
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
